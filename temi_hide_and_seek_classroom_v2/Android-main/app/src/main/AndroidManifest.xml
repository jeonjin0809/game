<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MediaPipe AAR은 minSdk 24로 선언되어 있지만 temi는 API 23 → 강제로 허용 (Temi_test_1 실기기에서 동작 확인함) -->
    <uses-sdk tools:overrideLibrary="com.google.mediapipe.tasks.vision,com.google.mediapipe.tasks.core" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- usesCleartextTraffic: 노트북 서버와 ws:// (비암호화) 통신 -->
    <application
        android:name=".DaycareApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DaycareTemi"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- SDK Settings 권한 선언 -->
        <meta-data android:name="com.robotemi.sdk.metadata.PERMISSIONS"
            android:value="com.robotemi.permission.settings" />
        <!-- 구버전 Launcher의 Detection Mode에서 Kiosk 앱 선언 필요.
             선언만으로 선택되지 않으므로 temi 설정에서 이 앱을 Kiosk로 선택해야 합니다. -->
        <meta-data android:name="com.robotemi.sdk.metadata.KIOSK" android:value="true" />
        <!-- temi 런처에 스킬(앱)로 표시 -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="@string/app_name" />
    </application>

</manifest>
